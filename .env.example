# Telegram Bot Token from @BotFather (NEVER commit real value)
BOT_TOKEN=

# Webhook secret — must match secret_token in setWebhook call
WEBHOOK_SECRET=

# Upstash Redis URL — required on Vercel for FSM state between requests
REDIS_URL=

# Production webhook URL (used by scripts/set_webhook.py)
# Example: https://kpbot.vercel.app/webhook
WEBHOOK_URL=

# Vercel CLI (optional, for local deploy scripts)
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=
