# Telegram Bot Token от @BotFather
BOT_TOKEN=your_bot_token_here

# Секрет для webhook (опционально, рекомендуется на Vercel)
WEBHOOK_SECRET=random_secret_string

# Redis для FSM на Vercel (обязательно для многошагового диалога)
# Upstash: https://upstash.com — бесплатный tier
REDIS_URL=redis://default:password@host:6379
